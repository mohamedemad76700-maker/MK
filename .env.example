PORT=8080
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgresql://mkschool:CHANGE_ME@127.0.0.1:5432/mkschool
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=CHANGE_ME_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
FRONTEND_ORIGIN=http://localhost:8080
# SMTP settings enable one-time password reset email. Use an app password from your mail provider.
APP_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VIDEO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VIDEO_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
PG_POOL_MAX=25
LOGIN_IP_LIMIT=30
REGISTER_IP_LIMIT=20
MEDIA_ROOT=./video_engine_backend/media
# Required for course video uploads/transcoding. Set this to ffmpeg.exe or its full Windows path.
FFMPEG_PATH=ffmpeg
TRUST_PROXY=false
# Optional: enables cloud-generated answers. Without it, MK AI uses the local school helper.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DAILY_LIMIT=60
